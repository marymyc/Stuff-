# Copy to .env and fill in only what you use. Never commit .env.
# Voice engine: elevenlabs | openai | kokoro | manual
TTS_ENGINE=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=
OPENAI_TTS_VOICE=onyx
KOKORO_VOICE=am_michael
# Big folder for Remotion temp bundles (each one copies public/, can fill a disk)
REMOTION_TMP=./remotion-tmp
# Optional: path to Chrome. Leave empty to let Remotion download its own headless browser.
CHROME_PATH=
# OpenGL backend for three.js renders: angle (Windows/macOS), egl or swangle (Linux/servers)
REMOTION_GL=angle
