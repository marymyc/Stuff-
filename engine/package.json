{
  "name": "animated-shorts-template",
  "version": "1.0.0",
  "private": true,
  "description": "Script in, vertical 2D-characters-in-3D-world animated short out. Agent-agnostic template (three.js + Remotion).",
  "scripts": {
    "check": "python tools/check_env.py",
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "new": "python tools/new_short.py",
    "stills": "node tools/stills.mjs",
    "render": "python tools/render.py"
  },
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "2.16.3",
    "@remotion/bundler": "4.0.242",
    "@remotion/cli": "4.0.242",
    "@remotion/renderer": "4.0.242",
    "@remotion/three": "4.0.242",
    "postprocessing": "6.36.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.242",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/three": "0.169.0",
    "typescript": "5.6.3"
  }
}
